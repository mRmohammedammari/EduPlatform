# ============================================
# EduPlatform Environment Variables Template
# ============================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!

# ============================================
# Database Configuration
# ============================================

# SQL Server
SQLSERVER_CONNECTION_STRING=Server=localhost\SQLEXPRESS;Database=EduPlatformDB;Trusted_Connection=True;TrustServerCertificate=True

# Cassandra
CASSANDRA_HOST=localhost
CASSANDRA_PORT=9042
CASSANDRA_KEYSPACE=edu_platform
CASSANDRA_USERNAME=
CASSANDRA_PASSWORD=

# Redis
REDIS_CONNECTION_STRING=localhost:6379

# ============================================
# Kafka Configuration
# ============================================

KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_ACTIVITY=user-activity-events
KAFKA_TOPIC_TEST_RESULTS=test-results-events
KAFKA_TOPIC_NOTIFICATIONS=notifications-events

# ============================================
# Authentication & Security
# ============================================

# JWT Secret Key (minimum 32 characters)
JWT_SECRET_KEY=your-super-secret-jwt-key-minimum-32-characters-long

# JWT Configuration
JWT_ISSUER=EduPlatform
JWT_AUDIENCE=EduPlatformUsers
JWT_EXPIRATION_HOURS=24

# ============================================
# External APIs
# ============================================

# OpenAI API Key for Chatbot
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# ============================================
# Azure Services (Production)
# ============================================

# Azure Key Vault
AZURE_KEY_VAULT_URL=https://your-keyvault.vault.azure.net/

# Application Insights
APPLICATIONINSIGHTS_INSTRUMENTATION_KEY=your-instrumentation-key

# Azure Storage (for file uploads)
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...
AZURE_STORAGE_CONTAINER=eduplatform-uploads

# ============================================
# Email Service (Optional)
# ============================================

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@eduplatform.com
SMTP_FROM_NAME=EduPlatform

# ============================================
# Other Settings
# ============================================

# Environment
ASPNETCORE_ENVIRONMENT=Development

# CORS Allowed Origins (comma-separated)
CORS_ALLOWED_ORIGINS=https://localhost:7286,http://localhost:5297

# File Upload Limits (in MB)
MAX_FILE_SIZE_MB=100

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=100
RATE_LIMIT_LOGIN_ATTEMPTS=5
