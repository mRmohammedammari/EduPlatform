@using System.Globalization

@*
    Carte de cours partagee entre le catalogue et les recommandations.
    Le conteneur est un vrai bouton accessible (role, tabindex, Entree/Espace) :
    il etait auparavant un <article> cliquable, inatteignable au clavier.
*@

<article class="course-card @(IsEnrolled ? "is-enrolled" : null)"
         data-course-id="@CourseId"
         role="button"
         tabindex="0"
         aria-label="@AriaLabel"
         @onclick="HandleClick"
         @onkeydown="HandleKeyDown">

    <CourseCover Title="@Title"
                 Category="@Category"
                 ThumbnailUrl="@ThumbnailUrl"
                 Tag="@Category"
                 CssClass="course-card-image" />

    <div class="course-info">
        <div class="course-card-topline">
            <span class="badge">@Level</span>
            @if (DurationMinutes > 0)
            {
                <span class="course-duration">@FormatDuration(DurationMinutes)</span>
            }
        </div>

        <h3>@Title</h3>

        <div class="course-card-rating">
            @if (ReviewCount > 0)
            {
                <StarRating Rating="@AverageRating" />
                <strong>@AverageRating.ToString("0.0", CultureInfo.InvariantCulture)</strong>
                <span>(@ReviewCount avis)</span>
            }
            else
            {
                <span class="course-card-noreview">Pas encore d'avis</span>
            }
        </div>

        <p class="course-card-description">@Description</p>

        @if (!string.IsNullOrWhiteSpace(Reason))
        {
            <p class="recommendation-reason">@Reason</p>
        }

        <div class="course-card-footer">
            <span class="course-card-facts">
                @if (ModuleCount > 0)
                {
                    <span>@ModuleCount module@(ModuleCount > 1 ? "s" : "")</span>
                }
                @if (EnrollmentCount > 0)
                {
                    <span>@EnrollmentCount inscrit@(EnrollmentCount > 1 ? "s" : "")</span>
                }
            </span>
            @if (IsEnrolled)
            {
                <span class="course-card-enrolled-tag">Deja inscrit</span>
            }
        </div>

        <span class="btn-primary course-card-action" aria-hidden="true">
            @(IsEnrolled ? "Reprendre le cours" : "Voir le cours") &rarr;
        </span>
    </div>
</article>

@code {
    [Parameter] public Guid CourseId { get; set; }
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public string Description { get; set; } = string.Empty;
    [Parameter] public string Category { get; set; } = string.Empty;
    [Parameter] public string Level { get; set; } = string.Empty;
    [Parameter] public int DurationMinutes { get; set; }
    [Parameter] public string ThumbnailUrl { get; set; } = string.Empty;
    [Parameter] public double AverageRating { get; set; }
    [Parameter] public int ReviewCount { get; set; }
    [Parameter] public int ModuleCount { get; set; }
    [Parameter] public int EnrollmentCount { get; set; }
    [Parameter] public bool IsEnrolled { get; set; }
    [Parameter] public string Reason { get; set; } = string.Empty;
    [Parameter] public EventCallback<Guid> OnSelected { get; set; }

    private string AriaLabel => $"Ouvrir le cours {Title}";

    private Task HandleClick() => OnSelected.InvokeAsync(CourseId);

    private async Task HandleKeyDown(KeyboardEventArgs args)
    {
        if (args.Key is "Enter" or " ")
            await HandleClick();
    }

    private static string FormatDuration(int minutes)
    {
        if (minutes < 60)
            return $"{minutes} min";

        var hours = minutes / 60;
        var rest = minutes % 60;
        return rest == 0 ? $"{hours} h" : $"{hours} h {rest:00}";
    }
}
