@inject NavigationManager Nav
@inject EduPlatform.Web.Services.AuthStateService AuthState
@implements IDisposable

<header class="public-header">
    <a class="public-brand" href="/">Edu<span>Platform</span></a>
    <NavLink class="public-nav-link" href="/explore">Explorer</NavLink>
    <NavLink class="public-nav-link" href="/recommendations">Parcours recommandés</NavLink>
    <SearchBar @bind-Value="SearchTerm"
               Submitted="SearchCourses"
               Placeholder="Que voulez-vous apprendre ?"
               AriaLabel="Rechercher un cours" />
    <a class="public-teach" href="/instructor">Enseigner sur EduPlatform</a>
    @if (AuthState.IsAuthenticated)
    {
        <button class="public-login" @onclick='() => Nav.NavigateTo("/profile")'>Mon espace</button>
        <button class="public-signup" @onclick="HandleLogout">Déconnexion</button>
    }
    else
    {
        <button class="public-login" @onclick='() => Nav.NavigateTo("/login")'>Connexion</button>
        <button class="public-signup" @onclick='() => Nav.NavigateTo("/register")'>S'inscrire</button>
    }
</header>

@code {
    private string SearchTerm = string.Empty;

    protected override void OnInitialized()
    {
        AuthState.OnChange += OnAuthStateChanged;
    }

    private async void OnAuthStateChanged()
    {
        await InvokeAsync(StateHasChanged);
    }

    private void SearchCourses(string searchTerm)
    {
        SearchTerm = searchTerm;
        Nav.NavigateTo($"/explore?search={Uri.EscapeDataString(searchTerm)}");
    }

    private async Task HandleLogout()
    {
        await AuthState.LogoutAsync();
        Nav.NavigateTo("/");
    }

    public void Dispose()
    {
        AuthState.OnChange -= OnAuthStateChanged;
    }
}
