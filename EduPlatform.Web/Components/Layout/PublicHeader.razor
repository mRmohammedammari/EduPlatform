@inject NavigationManager Nav
@inject EduPlatform.Web.Services.AuthStateService AuthState

<header class="public-header">
    <a class="public-brand" href="/">Edu<span>Platform</span></a>
    <NavLink class="public-nav-link" href="/explore">Explorer</NavLink>
    <NavLink class="public-nav-link" href="/recommendations">Parcours recommandés</NavLink>
    <form class="public-search" @onsubmit="SearchCourses">
        <span aria-hidden="true">?</span>
        <input @bind="SearchTerm" placeholder="Que voulez-vous apprendre ?" aria-label="Rechercher un cours" />
    </form>
    <a class="public-teach" href="/instructor">Enseigner sur EduPlatform</a>
    @if (AuthState.IsAuthenticated)
    {
        <button class="public-login" @onclick='() => Nav.NavigateTo("/profile")'>Mon espace</button>
    }
    else
    {
        <button class="public-login" @onclick='() => Nav.NavigateTo("/login")'>Connexion</button>
        <button class="public-signup" @onclick='() => Nav.NavigateTo("/register")'>S'inscrire</button>
    }
</header>

@code {
    private string SearchTerm = string.Empty;

    private void SearchCourses()
    {
        Nav.NavigateTo($"/explore?search={Uri.EscapeDataString(SearchTerm.Trim())}");
    }
}
