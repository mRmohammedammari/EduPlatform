@page "/"
@rendermode InteractiveServer
@inject NavigationManager Nav
@inject EduPlatform.Web.Services.AuthStateService AuthState
@inject IHttpClientFactory HttpClientFactory

<div class="market-home">
    <section class="market-hero-panel">
        <div class="hero-copy">
            <span class="eyebrow">APPRENDRE. PROGRESSER. PARTAGER.</span>
            <h1>Donnez de l'élan à votre avenir.</h1>
            <p>Des cours concrets, des parcours guidés et un suivi qui vous aide à aller jusqu'au bout.</p>
            <div class="market-hero-actions">
                <button class="market-button market-button-light" @onclick='() => Nav.NavigateTo("/courses")'>Explorer les cours</button>
                <button class="market-button market-button-outline" @onclick='() => Nav.NavigateTo("/register")'>Commencer gratuitement</button>
            </div>
        </div>

        <div class="hero-visual">
            <img src="https://images.unsplash.com/photo-1523240795612-9a054b0db644?auto=format&fit=crop&w=1200&q=80" alt="Étudiants qui apprennent ensemble" />
        </div>
    </section>

    <div class="market-stats-band">
        <div><strong>@FormatStat(Stats?.ActiveLearners)</strong><span>apprenants actifs</span></div>
        <div><strong>@FormatStat(Stats?.PublishedCourses)</strong><span>cours publiés</span></div>
        <div><strong>@FormatStat(Stats?.Categories)</strong><span>catégories</span></div>
        <div><strong>@FormatStat(Stats?.Modules)</strong><span>modules disponibles</span></div>
    </div>

    <section class="market-section market-features">
        <div class="section-heading-row centered-row">
            <div>
                <span class="eyebrow dark">POURQUOI ÉTUDIANTS</span>
                <h2>Une expérience pensée pour avancer sans friction.</h2>
            </div>
        </div>

        <div class="market-feature-grid">
            <article class="feature-panel">
                <span class="feature-icon">⚡</span>
                <h3>Progression rapide</h3>
                <p>Des parcours guidés, des modules clairs et une dynamique de suivi pour rester motivé.</p>
            </article>
            <article class="feature-panel">
                <span class="feature-icon">🎯</span>
                <h3>Apprentissage concret</h3>
                <p>Chaque cours combine théorie, exercices et mise en situation pour mieux retenir.</p>
            </article>
            <article class="feature-panel">
                <span class="feature-icon">🏆</span>
                <h3>Certifications utiles</h3>
                <p>Validez vos compétences avec des évaluations et des attestations de progression.</p>
            </article>
        </div>
    </section>

    <section class="market-section market-intro">
        <div class="intro-copy">
            <span class="eyebrow dark">APPRENDRE AUTREMENT</span>
            <h2>Les compétences qui comptent vraiment.</h2>
            <p>Des formations conçues pour passer de la curiosité à la pratique, avec vidéo, contenu écrit et tests de validation.</p>
        </div>

        <div class="market-category-grid">
            <button class="category-tile" @onclick='() => GoToCourses("Informatique")'>
                <img src="https://images.unsplash.com/photo-1677442136019-21780ecad995?auto=format&fit=crop&w=700&q=80" alt="Intelligence artificielle" />
                <span>Intelligence artificielle</span>
            </button>
            <button class="category-tile" @onclick='() => GoToCourses("Economie")'>
                <img src="https://images.unsplash.com/photo-1551288049-bebda4e38f71?auto=format&fit=crop&w=700&q=80" alt="Analyse de données" />
                <span>Data & stratégie</span>
            </button>
            <button class="category-tile" @onclick='() => GoToCourses("Informatique")'>
                <img src="https://images.unsplash.com/photo-1516321318423-f06f85e504b3?auto=format&fit=crop&w=700&q=80" alt="Développement logiciel" />
                <span>Développement logiciel</span>
            </button>
        </div>
    </section>

    <section class="market-section market-courses">
        <div class="section-heading-row">
            <div>
                <span class="eyebrow dark">À LA UNE</span>
                <h2>Les cours qui font avancer.</h2>
            </div>
            <button class="text-link" @onclick='() => Nav.NavigateTo("/courses")'>Voir tout le catalogue →</button>
        </div>

        @if (FeaturedCourses is null)
        {
            <p class="market-courses-empty">Chargement des cours...</p>
        }
        else if (FeaturedCourses.Count == 0)
        {
            <p class="market-courses-empty">Aucun cours publié pour le moment.</p>
        }
        else
        {
            <div class="market-course-grid">
                @foreach (var course in FeaturedCourses)
                {
                    <article class="market-course-card" @onclick="() => GoToCourse(course.Id)" style="cursor: pointer;">
                        <div class="market-course-cover" style="@GetCoverStyle(course.Category)"></div>
                        <div class="course-card-copy">
                            <span class="course-kicker">@course.Category.ToUpperInvariant()</span>
                            <h3>@course.Title</h3>
                            <p>@course.Description</p>
                            <div class="course-card-meta"><strong>@course.Level</strong><small>@course.Modules.Count module(s)</small></div>
                        </div>
                    </article>
                }
            </div>
        }
    </section>

    <section class="market-section market-pathways">
        <div class="pathway-copy">
            <span class="eyebrow">VOTRE PROCHAIN CHAPITRE</span>
            <h2>Un parcours qui s'adapte à vous.</h2>
            <p>Votre progression et vos résultats nous aident à vous proposer les prochaines formations utiles.</p>
            <button class="market-button market-button-light" @onclick='() => Nav.NavigateTo("/recommendations")'>Voir mes recommandations</button>
        </div>

        <div class="pathway-art">
            <div class="art-shape art-shape-one"></div>
            <div class="art-shape art-shape-two"></div>
            <div class="art-window">
                <span>PROGRESS</span>
                <strong>+ 42%</strong>
                <small>Cette semaine</small>
            </div>
        </div>
    </section>

    <section class="market-trust">
        <span>Une plateforme pensée pour apprendre avec confiance</span>
        <div><b>SQL</b><b>ML.NET</b><b>Kafka</b><b>Blazor</b><b>Cloud-ready</b></div>
    </section>

    <footer class="market-footer">
        <div>
            <a class="market-logo footer-logo" href="/">Edu<span>Platform</span></a>
            <p>Apprendre avec méthode. Grandir avec confiance.</p>
        </div>
        <div>
            <strong>Explorer</strong>
            <a href="/courses">Tous les cours</a>
            <a href="/recommendations">Recommandations</a>
            <a href="/register">Créer un compte</a>
        </div>
        <div>
            <strong>La plateforme</strong>
            <a href="/activity">Votre activité</a>
            <a href="/progress">Votre progression</a>
            <a href="/notifications">Notifications</a>
        </div>
        <div>
            <strong>Pour les enseignants</strong>
            <a href="/instructor">Créer un cours</a>
            <a href="/login">Se connecter</a>
        </div>
    </footer>
</div>

@code {
    private CourseStatsDto? Stats;
    private List<CourseSummaryDto>? FeaturedCourses;

    protected override async Task OnInitializedAsync()
    {
        var httpClient = HttpClientFactory.CreateClient("EduPlatformAPI");

        try
        {
            Stats = await httpClient.GetFromJsonAsync<CourseStatsDto>("api/courses/stats");
        }
        catch (Exception)
        {
            Stats = null;
        }

        try
        {
            var courses = await httpClient.GetFromJsonAsync<List<CourseSummaryDto>>("api/courses");
            FeaturedCourses = (courses ?? new List<CourseSummaryDto>())
                .OrderByDescending(c => c.CreatedAt)
                .Take(4)
                .ToList();
        }
        catch (Exception)
        {
            FeaturedCourses = new List<CourseSummaryDto>();
        }
    }

    private static string FormatStat(int? value) => value is null ? "—" : value.Value.ToString();

    private void GoToCourses(string category) => Nav.NavigateTo($"/courses?category={Uri.EscapeDataString(category)}");

    private void GoToCourse(Guid id) => Nav.NavigateTo($"/courses/{id}");

    private string GetCoverStyle(string category)
    {
        return category switch
        {
            "Informatique" => "background: linear-gradient(135deg, #5b5df6 0%, #8b5cf6 100%);",
            "Economie" => "background: linear-gradient(135deg, #0ea5e9 0%, #2563eb 100%);",
            "Physique" => "background: linear-gradient(135deg, #10b981 0%, #14b8a6 100%);",
            "Langues" => "background: linear-gradient(135deg, #f59e0b 0%, #ef4444 100%);",
            _ => "background: linear-gradient(135deg, #1f2937 0%, #6d28d9 100%);"
        };
    }

    private class CourseStatsDto
    {
        public int PublishedCourses { get; set; }
        public int Categories { get; set; }
        public int Modules { get; set; }
        public int ActiveLearners { get; set; }
    }

    private class CourseSummaryDto
    {
        public Guid Id { get; set; }
        public string Title { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
        public string Category { get; set; } = string.Empty;
        public string Level { get; set; } = string.Empty;
        public DateTime CreatedAt { get; set; }
        public List<object> Modules { get; set; } = new();
    }
}
