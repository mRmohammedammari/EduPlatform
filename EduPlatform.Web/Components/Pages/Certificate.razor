@page "/courses/{CourseId:guid}/certificate"
@rendermode InteractiveServer
@implements IDisposable
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager Nav
@inject EduPlatform.Web.Services.AuthStateService AuthState
@inject IJSRuntime JS

@if (!AuthState.IsAuthenticated)
{
    <div class="profile-container">
        <div class="alert-error">Connectez-vous pour consulter votre certificat.</div>
        <button class="btn-primary" @onclick="GoToLogin">Se connecter</button>
    </div>
}
else if (IsLoading)
{
    <p>Vérification de votre certificat...</p>
}
else if (!string.IsNullOrWhiteSpace(ErrorMessage))
{
    <div class="profile-container">
        <div class="alert-error">@ErrorMessage</div>
        <button class="btn-secondary" @onclick="GoToCourse">Retour au cours</button>
    </div>
}
else if (CertificateData != null)
{
    <div class="certificate-container">
        <div class="certificate-card">
            <span class="badge">EduPlatform</span>
            <h1>Certificat de réussite</h1>
            <p>Ce certificat est décerné à</p>
            <h2>@CertificateData.StudentName</h2>
            <p>pour avoir réussi le cours</p>
            <h3>@CertificateData.CourseTitle</h3>
            <p>Score obtenu : @CertificateData.Score / @CertificateData.MaxScore</p>
            <p>Délivré le @CertificateData.IssuedAt.ToLocalTime().ToString("dd/MM/yyyy")</p>
            <small>Identifiant : @CertificateData.CertificateId</small>
            <p><a href="@CertificateData.VerificationUrl" target="_blank" rel="noopener">Vérifier ce certificat</a></p>
            <img class="certificate-qr" src="@CertificateData.QrCodeUrl" alt="QR code de vérification du certificat" />
            <button class="btn-primary" @onclick="DownloadCertificate">Télécharger le PDF</button>
        </div>
    </div>
}

@code {
    [Parameter] public Guid CourseId { get; set; }

    private bool IsLoading = true;
    private string ErrorMessage = string.Empty;
    private CertificateDto? CertificateData;
    private bool DataLoaded;

    protected override void OnInitialized()
    {
        AuthState.OnChange += OnAuthStateChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await AuthState.InitializeAsync();
            await EvaluateAuthStateAsync();
        }
    }

    private async void OnAuthStateChanged()
    {
        await InvokeAsync(async () =>
        {
            await EvaluateAuthStateAsync();
            StateHasChanged();
        });
    }

    private async Task EvaluateAuthStateAsync()
    {
        if (!AuthState.IsAuthenticated)
        {
            IsLoading = false;
            return;
        }
        if (DataLoaded)
            return;
        DataLoaded = true;

        try
        {
            var response = await CreateAuthorizedClient().GetAsync($"api/certificates/{CourseId}");
            if (response.IsSuccessStatusCode)
            {
                CertificateData = await response.Content.ReadFromJsonAsync<CertificateDto>();
            }
            else
            {
                var body = await response.Content.ReadFromJsonAsync<Dictionary<string, string>>();
                ErrorMessage = body?.GetValueOrDefault("message") ??
                    "Vous n'�tes pas encore �ligible au certificat.";
            }
        }
        catch
        {
            ErrorMessage = "Impossible de v�rifier le certificat.";
        }
        finally
        {
            IsLoading = false;
        }
    }

    public void Dispose()
    {
        AuthState.OnChange -= OnAuthStateChanged;
    }

    private HttpClient CreateAuthorizedClient() => HttpClientFactory.CreateAuthorizedClient(AuthState);

    private void GoToLogin() => Nav.NavigateTo("/login");
    private void GoToCourse() => Nav.NavigateTo($"/courses/{CourseId}");

    private async Task DownloadCertificate()
    {
        var response = await CreateAuthorizedClient().GetAsync($"api/certificates/{CourseId}/pdf");
        if (!response.IsSuccessStatusCode || CertificateData is null)
            return;

        var content = await response.Content.ReadAsByteArrayAsync();
        await JS.InvokeVoidAsync("eduPlatformSession.download", $"{CertificateData.CertificateId}.pdf", content);
    }

    private sealed class CertificateDto
    {
        public string CertificateId { get; set; } = string.Empty;
        public string StudentName { get; set; } = string.Empty;
        public string CourseTitle { get; set; } = string.Empty;
        public DateTime IssuedAt { get; set; }
        public decimal Score { get; set; }
        public decimal MaxScore { get; set; }
        public string VerificationUrl { get; set; } = string.Empty;
        public string QrCodeUrl => $"{VerificationUrl}/qr";
    }
}
