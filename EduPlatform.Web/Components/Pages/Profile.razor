@page "/profile"
@rendermode InteractiveServer
@implements IDisposable
@inject EduPlatform.Web.Services.AuthStateService AuthState
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager Nav

<div class="profile-container">
    @if (!AuthState.IsAuthenticated)
    {
        <div class="alert-error">Vous devez être connecté pour accéder à cette page.</div>
        <button class="btn-primary" @onclick='() => Nav.NavigateTo("/login")'>Se connecter</button>
    }
    else
    {
        <div class="profile-header">
            <div class="profile-avatar">@(AuthState.FirstName.Length > 0 ? AuthState.FirstName[0].ToString().ToUpper() : "U")</div>
            <h1>@AuthState.FirstName</h1>
            <p class="profile-email">@AuthState.Email</p>
            <span class="badge">@AuthState.Role</span>
            <button class="btn-secondary btn-small" @onclick="ToggleEdit">
                @(IsEditing ? "Annuler" : "Modifier le profil")
            </button>
        </div>

        @if (IsEditing)
        {
            <div class="profile-section">
                <h2>Modifier mes informations</h2>
                @if (!string.IsNullOrWhiteSpace(ProfileMessage))
                {
                    <div class="alert-error">@ProfileMessage</div>
                }
                <div class="form-group">
                    <label>Prénom</label>
                    <input type="text" @bind="EditFirstName" />
                </div>
                <div class="form-group">
                    <label>Nom</label>
                    <input type="text" @bind="EditLastName" />
                </div>
                <button class="btn-primary" @onclick="SaveProfile">Enregistrer</button>
            </div>

            <div class="profile-section">
                <h2>Changer mon mot de passe</h2>
                @if (!string.IsNullOrWhiteSpace(PasswordMessage))
                {
                    <div class="alert-error">@PasswordMessage</div>
                }
                <div class="form-group">
                    <label>Mot de passe actuel</label>
                    <input type="password" @bind="CurrentPassword" />
                </div>
                <div class="form-group">
                    <label>Nouveau mot de passe</label>
                    <input type="password" @bind="NewPassword" />
                </div>
                <button class="btn-primary" @onclick="ChangePassword">Changer le mot de passe</button>
            </div>
        }

        <div class="profile-section">
            <h2>Mes inscriptions aux cours</h2>
            @if (Enrollments == null)
            {
                <p>Chargement...</p>
            }
            else if (!Enrollments.Any())
            {
                <p>Vous n'êtes inscrit à aucun cours pour le moment.</p>
                <button class="btn-primary" @onclick='() => Nav.NavigateTo("/courses")'>Découvrir les cours</button>
            }
            else
            {
                <div class="enrollments-list">
                    @foreach (var enrollment in Enrollments)
                    {
                        <div class="enrollment-card">
                            <div class="enrollment-info">
                                <h3>@enrollment.CourseTitle</h3>
                                <p>Inscrit le : @enrollment.EnrolledAt.ToString("dd/MM/yyyy HH:mm")</p>
                                <div class="progress-bar">
                                    <div class="progress-fill" style="width: @(enrollment.ProgressPercent)%"></div>
                                </div>
                                <span>@enrollment.ProgressPercent% complété</span>
                            </div>
                            <button class="btn-secondary" @onclick="() => GoToCourse(enrollment.CourseId)">
                                Continuer →
                            </button>
                        </div>
                    }
                </div>
            }
        </div>

        <div class="profile-section">
            <h2>Statistiques</h2>
            <div class="stats-grid">
                <div class="stat-card">
                    <span class="stat-value">@(Enrollments?.Count ?? 0)</span>
                    <span class="stat-label">Cours inscrits</span>
                </div>
                <div class="stat-card">
                    <span class="stat-value">@(Enrollments?.Count(e => e.ProgressPercent == 100) ?? 0)</span>
                    <span class="stat-label">Cours terminés</span>
                </div>
                <div class="stat-card">
                    <span class="stat-value">@(Enrollments?.Count(e => e.ProgressPercent > 0 && e.ProgressPercent < 100) ?? 0)</span>
                    <span class="stat-label">En cours</span>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private List<EnrollmentDto>? Enrollments;
    private string LastName = string.Empty;
    private bool IsEditing;
    private string EditFirstName = string.Empty;
    private string EditLastName = string.Empty;
    private string ProfileMessage = string.Empty;
    private string CurrentPassword = string.Empty;
    private string NewPassword = string.Empty;
    private string PasswordMessage = string.Empty;

    protected override void OnInitialized()
    {
        AuthState.OnChange += OnAuthStateChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await AuthState.InitializeAsync();
            await EvaluateAuthStateAsync();
        }
    }

    private async void OnAuthStateChanged()
    {
        await InvokeAsync(async () =>
        {
            await EvaluateAuthStateAsync();
            StateHasChanged();
        });
    }

    private async Task EvaluateAuthStateAsync()
    {
        if (!AuthState.IsAuthenticated)
        {
            Nav.NavigateTo("/login");
            return;
        }

        if (Enrollments == null)
        {
            await LoadEnrollments();
            await LoadProfileDetails();
        }
    }

    private async Task LoadProfileDetails()
    {
        try
        {
            var me = await HttpClientFactory.CreateAuthorizedClient(AuthState)
                .GetFromJsonAsync<MeDto>("api/auth/me");
            if (me != null)
                LastName = me.LastName;
        }
        catch
        {
            // Non-blocking: profile editing will just start with an empty last name field.
        }
    }

    private async Task LoadEnrollments()
    {
        try
        {
            var httpClient = HttpClientFactory.CreateAuthorizedClient(AuthState);
            Enrollments = await httpClient.GetFromJsonAsync<List<EnrollmentDto>>(
                "api/progress/enrollments") ?? new();
        }
        catch
        {
            Enrollments = new();
        }
    }

    public void Dispose()
    {
        AuthState.OnChange -= OnAuthStateChanged;
    }

    private void ToggleEdit()
    {
        IsEditing = !IsEditing;
        if (IsEditing)
        {
            EditFirstName = AuthState.FirstName;
            EditLastName = LastName;
            ProfileMessage = string.Empty;
            PasswordMessage = string.Empty;
            CurrentPassword = string.Empty;
            NewPassword = string.Empty;
        }
    }

    private async Task SaveProfile()
    {
        ProfileMessage = string.Empty;
        try
        {
            var response = await HttpClientFactory.CreateAuthorizedClient(AuthState).PutAsJsonAsync(
                "api/auth/profile", new { firstName = EditFirstName, lastName = EditLastName });

            if (response.IsSuccessStatusCode)
            {
                LastName = EditLastName;
                await AuthState.UpdateFirstNameAsync(EditFirstName);
                ProfileMessage = "Profil mis à jour.";
            }
            else
            {
                ProfileMessage = "La mise à jour du profil a échoué.";
            }
        }
        catch
        {
            ProfileMessage = "Erreur de connexion.";
        }
    }

    private async Task ChangePassword()
    {
        PasswordMessage = string.Empty;
        if (string.IsNullOrWhiteSpace(CurrentPassword) || string.IsNullOrWhiteSpace(NewPassword))
        {
            PasswordMessage = "Renseignez le mot de passe actuel et le nouveau.";
            return;
        }

        try
        {
            var response = await HttpClientFactory.CreateAuthorizedClient(AuthState).PostAsJsonAsync(
                "api/auth/change-password", new { currentPassword = CurrentPassword, newPassword = NewPassword });

            if (response.IsSuccessStatusCode)
            {
                PasswordMessage = "Mot de passe modifié avec succès.";
                CurrentPassword = string.Empty;
                NewPassword = string.Empty;
            }
            else
            {
                var body = await response.Content.ReadFromJsonAsync<Dictionary<string, string>>();
                PasswordMessage = body?.GetValueOrDefault("message") ?? "Le changement de mot de passe a échoué.";
            }
        }
        catch
        {
            PasswordMessage = "Erreur de connexion.";
        }
    }

    private void GoToCourse(Guid courseId)
    {
        Nav.NavigateTo($"/courses/{courseId}");
    }

    private class EnrollmentDto
    {
        public Guid CourseId { get; set; }
        public string CourseTitle { get; set; } = string.Empty;
        public DateTime EnrolledAt { get; set; }
        public int ProgressPercent { get; set; }
    }

    private class MeDto
    {
        public string FirstName { get; set; } = string.Empty;
        public string LastName { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
    }
}
