@page "/recommendations"
@rendermode InteractiveServer
@implements IDisposable
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager Nav
@inject EduPlatform.Web.Services.AuthStateService AuthState

@if (!AuthState.IsAuthenticated)
{
    <div class="profile-container">
        <div class="alert-error">Connectez-vous pour obtenir des recommandations personnalisées.</div>
        <button class="btn-primary" @onclick="GoToLogin">Se connecter</button>
    </div>
}
else
{
    <div class="explore-page">
        <section class="explore-hero">
            <div class="explore-copy">
                <span class="eyebrow dark">RECOMMANDÉ POUR VOUS</span>
                <h1>Des cours choisis pour votre parcours.</h1>
                <p>Basées sur votre activité et votre progression, voici les formations qui vous feront avancer.</p>
            </div>

            <div class="explore-metrics">
                <div class="mini-stat">
                    <strong>@Courses.Count</strong>
                    <span>recommandation(s)</span>
                </div>
                <button class="market-button explore-recommendations" @onclick="GoToCourses">Voir tout le catalogue</button>
            </div>
        </section>

        @if (IsLoading)
        {
            <p class="explore-empty">Chargement des recommandations...</p>
        }
        else if (!string.IsNullOrWhiteSpace(ErrorMessage))
        {
            <div class="alert-error">@ErrorMessage</div>
        }
        else if (Courses.Count == 0)
        {
            <div class="course-section">
                <h2>Explorez le catalogue</h2>
                <p>Aucune recommandation n'est disponible pour le moment.</p>
                <button class="btn-primary" @onclick="GoToCourses">Voir tous les cours</button>
            </div>
        }
        else
        {
            <div class="explore-toolbar">
                <div class="filters">
                    <select class="explore-select" @bind="CategoryFilter">
                        <option value="">Toutes les catégories</option>
                        @foreach (var category in Categories)
                        {
                            <option value="@category">@category</option>
                        }
                    </select>
                    <select class="explore-select" @bind="LevelFilter">
                        <option value="">Tous les niveaux</option>
                        @foreach (var level in Levels)
                        {
                            <option value="@level">@level</option>
                        }
                    </select>
                    <select class="explore-select" @bind="SortOrder">
                        <option value="recommended">Pertinence</option>
                        <option value="title">Titre</option>
                        <option value="duration-asc">Durée croissante</option>
                        <option value="duration-desc">Durée décroissante</option>
                    </select>
                </div>
                <span class="recommendation-count">@FilteredCourses.Count() recommandation(s)</span>
            </div>

            @if (!FilteredCourses.Any())
            {
                <div class="explore-empty">Aucun cours ne correspond à vos filtres.</div>
            }

            <div class="CourseList-grid">
                @foreach (var course in FilteredCourses)
                {
                    <CourseCard CourseId="@course.Id"
                                Title="@course.Title"
                                Description="@course.Description"
                                Category="@course.Category"
                                Level="@course.Level"
                                DurationMinutes="@course.DurationMinutes"
                                ThumbnailUrl="@course.ThumbnailUrl"
                                AverageRating="@course.AverageRating"
                                ReviewCount="@course.ReviewCount"
                                ModuleCount="@course.ModuleCount"
                                Reason="@course.RecommendationReason"
                                OnSelected="GoToCourse" />
                }
            </div>
        }
    </div>
}

@code {
    private bool IsLoading = true;
    private string ErrorMessage = string.Empty;
    private List<CourseDto> Courses = new();
    private bool DataLoaded;
    private string CategoryFilter = string.Empty;
    private string LevelFilter = string.Empty;
    private string SortOrder = "recommended";

    private IEnumerable<CourseDto> FilteredCourses
    {
        get
        {
            var filtered = Courses
                .Where(course => string.IsNullOrWhiteSpace(CategoryFilter) || course.Category == CategoryFilter)
                .Where(course => string.IsNullOrWhiteSpace(LevelFilter) || course.Level == LevelFilter);

            return SortOrder switch
            {
                "title" => filtered.OrderBy(course => course.Title),
                "duration-asc" => filtered.OrderBy(course => course.DurationMinutes),
                "duration-desc" => filtered.OrderByDescending(course => course.DurationMinutes),
                _ => filtered
            };
        }
    }

    private IEnumerable<string> Categories => Courses
        .Select(course => course.Category)
        .Where(category => !string.IsNullOrWhiteSpace(category))
        .Distinct()
        .OrderBy(category => category);

    private IEnumerable<string> Levels => Courses
        .Select(course => course.Level)
        .Where(level => !string.IsNullOrWhiteSpace(level))
        .Distinct()
        .OrderBy(level => level);

    protected override void OnInitialized()
    {
        AuthState.OnChange += OnAuthStateChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await AuthState.InitializeAsync();
            await EvaluateAuthStateAsync();
        }
    }

    private async void OnAuthStateChanged()
    {
        await InvokeAsync(async () =>
        {
            await EvaluateAuthStateAsync();
            StateHasChanged();
        });
    }

    private async Task EvaluateAuthStateAsync()
    {
        if (!AuthState.IsAuthenticated)
        {
            IsLoading = false;
            return;
        }
        if (DataLoaded)
            return;
        DataLoaded = true;

        try
        {
            var client = HttpClientFactory.CreateAuthorizedClient(AuthState);
            Courses = await client.GetFromJsonAsync<List<CourseDto>>("api/recommendations") ?? new();
        }
        catch
        {
            ErrorMessage = "Impossible de charger les recommandations. Réessayez plus tard.";
        }
        finally
        {
            IsLoading = false;
        }
    }

    public void Dispose()
    {
        AuthState.OnChange -= OnAuthStateChanged;
    }

    private void GoToLogin() => Nav.NavigateTo("/login");
    private void GoToCourses() => Nav.NavigateTo("/courses");
    private void GoToCourse(Guid courseId) => Nav.NavigateTo($"/courses/{courseId}");

    private sealed class CourseDto
    {
        public Guid Id { get; set; }
        public string Title { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
        public string Category { get; set; } = string.Empty;
        public string Level { get; set; } = string.Empty;
        public int DurationMinutes { get; set; }
        public string ThumbnailUrl { get; set; } = string.Empty;
        public int ModuleCount { get; set; }
        public double AverageRating { get; set; }
        public int ReviewCount { get; set; }
        public string RecommendationReason { get; set; } = string.Empty;
    }
}
