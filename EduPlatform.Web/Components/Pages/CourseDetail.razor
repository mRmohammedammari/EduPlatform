@page "/courses/{CourseId:guid}"
@rendermode InteractiveServer
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager Nav
@inject EduPlatform.Web.Services.AuthStateService AuthState
@using System.Globalization

@if (Course != null)
{
    <PageTitle>@Course.Title - EduPlatform</PageTitle>

    <div class="course-detail-container">

        @* --- 1. En-tete : ce qu'est le cours, sa note, son volume --- *@
        <div class="course-hero-card">
            <div class="course-hero-copy">
                <span class="badge">@Course.Level</span>
                <h1>@Course.Title</h1>
                <p>@Course.Description</p>

                <div class="course-meta">
                    @if (Reviews is { TotalReviews: > 0 })
                    {
                        <span class="course-meta-rating">
                            <StarRating Rating="@Reviews.AverageRating" ReviewCount="@Reviews.TotalReviews" />
                            <strong>@Reviews.AverageRating.ToString("0.0", CultureInfo.InvariantCulture)</strong>
                            <a href="#avis">(@Reviews.TotalReviews avis)</a>
                        </span>
                    }
                    <span>@FormatDuration(Course.DurationMinutes)</span>
                    <span>@Course.Modules.Count module@(Course.Modules.Count > 1 ? "s" : "")</span>
                    <span>@Course.Category</span>
                </div>
            </div>

            <CourseCover Title="@Course.Title"
                         Category="@Course.Category"
                         ThumbnailUrl="@Course.ThumbnailUrl"
                         CssClass="course-hero-cover" />
        </div>

        @* --- 2. Bandeaux d'etat --- *@
        @if (IsPreview)
        {
            <div class="preview-banner">
                Prévisualisation instructeur : ce cours n'est pas présenté comme une inscription apprenant.
            </div>
        }
        else if (IsEnrolled)
        {
            <div class="enrolled-banner">
                Vous êtes inscrit à ce cours@(string.IsNullOrWhiteSpace(EnrolledPlan) ? "" : $" (Plan : {EnrolledPlan})")
            </div>
        }

        @* --- 3. Programme : desormais visible AVANT les avis, et aussi pour les
               visiteurs non inscrits. C'est l'information qui declenche l'inscription ;
               elle etait auparavant reservee aux inscrits. --- *@
        <div class="course-section course-syllabus">
            <div class="section-title-row">
                <h2>Programme du cours</h2>
                <span class="syllabus-summary">
                    @Course.Modules.Count module@(Course.Modules.Count > 1 ? "s" : "") &middot; @FormatDuration(Course.DurationMinutes)
                </span>
            </div>

            @if (Course.Modules.Any())
            {
                <ol class="modules-list">
                    @foreach (var module in Course.Modules.OrderBy(m => m.Order))
                    {
                        <li class="module-item @(CanOpenModules ? "is-open" : "is-locked")">
                            <span class="module-item-index">@module.Order</span>
                            <span class="module-item-title">@module.Title</span>
                            <span class="module-item-duration">@FormatDuration(module.DurationMinutes)</span>
                            @if (!CanOpenModules)
                            {
                                <span class="module-item-lock" title="Accessible après inscription" aria-label="Accessible après inscription">&#128274;</span>
                            }
                        </li>
                    }
                </ol>

                @if (!CanOpenModules)
                {
                    <p class="syllabus-hint">Inscrivez-vous pour accéder au contenu des modules.</p>
                }
            }
            else
            {
                <p>Le programme de ce cours n'est pas encore publié.</p>
            }
        </div>

        @* --- 4. Action : apprendre si inscrit, sinon choisir un plan --- *@
        @if (IsEnrolled && !IsPreview)
        {
            <div class="course-section course-actions">
                <button class="btn-primary" @onclick="GoToLearning">Commencer le cours</button>
                <button class="btn-primary" @onclick="GoToTest">Passer le test</button>
                <button class="btn-secondary" @onclick="GoToCertificate">Certificat</button>
            </div>
        }
        else if (!IsPreview)
        {
            @if (!ShowPayment)
            {
                <div class="course-section">
                    <h2>Choisissez votre plan</h2>
                    <div class="pricing-grid">
                        <div class="pricing-card @(SelectedPlan == "Free" ? "selected" : "")" @onclick='() => SelectPlan("Free")'>
                            <h3>Gratuit</h3>
                            <div class="pricing-price">0 DA</div>
                            <ul class="pricing-features">
                                <li>Accès aux 2 premiers modules</li>
                                <li>Quiz de base</li>
                                <li class="disabled">Certificat</li>
                                <li class="disabled">Exercices avancés</li>
                                <li class="disabled">Support instructeur</li>
                            </ul>
                            <button class="btn-secondary" @onclick='() => SelectPlan("Free")'>Sélectionner</button>
                        </div>

                        <div class="pricing-card recommended @(SelectedPlan == "Standard" ? "selected" : "")" @onclick='() => SelectPlan("Standard")'>
                            <span class="pricing-badge">Recommandé</span>
                            <h3>Standard</h3>
                            <div class="pricing-price">@Course.Price.ToString("N2") DA</div>
                            <ul class="pricing-features">
                                <li>Accès à tous les modules</li>
                                <li>Tous les quiz</li>
                                <li>Certificat de complétion</li>
                                <li>Exercices avancés</li>
                                <li class="disabled">Support instructeur</li>
                            </ul>
                            <button class="btn-primary" @onclick='() => SelectPlan("Standard")'>Sélectionner</button>
                        </div>

                        <div class="pricing-card @(SelectedPlan == "Premium" ? "selected" : "")" @onclick='() => SelectPlan("Premium")'>
                            <h3>Premium</h3>
                            <div class="pricing-price">@((Course.Price * 1.5m).ToString("N2")) DA</div>
                            <ul class="pricing-features">
                                <li>Accès à tous les modules</li>
                                <li>Tous les quiz</li>
                                <li>Certificat de complétion</li>
                                <li>Exercices avancés</li>
                                <li>Support instructeur 1-on-1</li>
                            </ul>
                            <button class="btn-secondary" @onclick='() => SelectPlan("Premium")'>Sélectionner</button>
                        </div>
                    </div>
                    <div class="pricing-action">
                        <button class="btn-primary btn-large" @onclick="ProceedToPayment" disabled="@(string.IsNullOrEmpty(SelectedPlan))">
                            Continuer vers le paiement
                        </button>
                    </div>
                </div>
            }
            else
            {
                <div class="course-section">
                    <h2>Paiement - Plan @SelectedPlan</h2>
                    <div class="payment-summary">
                        <div class="payment-row">
                            <span>Cours</span>
                            <span>@Course.Title</span>
                        </div>
                        <div class="payment-row">
                            <span>Plan</span>
                            <span>@SelectedPlan</span>
                        </div>
                        <div class="payment-row total">
                            <span>Total</span>
                            <span>@GetPlanPrice().ToString("N2") DA</span>
                        </div>
                    </div>

                    @if (SelectedPlan != "Free")
                    {
                        <div class="payment-form">
                            <h3>Informations de paiement</h3>
                            <div class="form-group">
                                <label>Nom sur la carte</label>
                                <input type="text" @bind="CardName" placeholder="Nom complet" />
                            </div>
                            <div class="form-group">
                                <label>Numéro de carte</label>
                                <input type="text" @bind="CardNumber" placeholder="1234 5678 9012 3456" maxlength="19" />
                            </div>
                            <div class="form-row">
                                <div class="form-group">
                                    <label>Expiration</label>
                                    <input type="text" @bind="CardExpiry" placeholder="MM/AA" maxlength="5" />
                                </div>
                                <div class="form-group">
                                    <label>CVV</label>
                                    <input type="text" @bind="CardCvv" placeholder="123" maxlength="3" />
                                </div>
                            </div>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(PaymentError))
                    {
                        <div class="alert-error">@PaymentError</div>
                    }

                    <div class="payment-actions">
                        <button class="btn-secondary" @onclick="GoBack">Retour</button>
                        <button class="btn-primary btn-large" @onclick="ProcessPayment" disabled="@IsProcessing">
                            @(IsProcessing ? "Traitement en cours..." : (SelectedPlan == "Free" ? "S'inscrire gratuitement" : "Payer et s'inscrire"))
                        </button>
                    </div>
                </div>
            }
        }

        @* --- 5. Avis : deplaces en fin de page. Ils etaient affiches avant meme
               le programme, donc avant que le visiteur sache ce que contient le cours. --- *@
        @if (Reviews is not null)
        {
            <div class="course-section course-reviews" id="avis">
                <div class="reviews-heading">
                    <h2>Avis des apprenants</h2>
                    @if (Reviews.TotalReviews > 0)
                    {
                        <strong>
                            <StarRating Rating="@Reviews.AverageRating" ReviewCount="@Reviews.TotalReviews" />
                            @Reviews.AverageRating.ToString("0.0", CultureInfo.InvariantCulture)
                        </strong>
                        <span>(@Reviews.TotalReviews avis)</span>
                    }
                </div>

                @if (Reviews.TotalReviews > 0)
                {
                    @* Distribution des notes : la roadmap la prevoyait, seule la moyenne etait affichee. *@
                    <div class="rating-distribution">
                        @for (var star = 5; star >= 1; star--)
                        {
                            var count = Reviews.Reviews.Count(review => review.Rating == star);
                            var percent = Reviews.TotalReviews == 0 ? 0 : count * 100 / Reviews.TotalReviews;
                            <div class="rating-bar-row">
                                <span class="rating-bar-label">@star &#9733;</span>
                                <span class="rating-bar" role="img" aria-label="@($"{star} étoiles : {count} avis")">
                                    <span class="rating-bar-fill" style="width: @percent%"></span>
                                </span>
                                <span class="rating-bar-count">@count</span>
                            </div>
                        }
                    </div>
                }

                @if (IsEnrolled && !IsPreview)
                {
                    <div class="review-form">
                        <span class="review-form-label">Votre note</span>
                        @* Etoiles cliquables : la note passait par un <select>, peu engageant. *@
                        <div class="review-rating-input" role="radiogroup" aria-label="Votre note">
                            @for (var star = 1; star <= 5; star++)
                            {
                                var value = star;
                                <button type="button"
                                        class="review-star-button @(ReviewRating >= value ? "is-active" : "")"
                                        role="radio"
                                        aria-checked="@(ReviewRating == value)"
                                        aria-label="@($"{value} sur 5")"
                                        @onclick="() => ReviewRating = value">
                                    @(ReviewRating >= value ? "?" : "?")
                                </button>
                            }
                        </div>
                        <textarea @bind="ReviewComment" rows="3" placeholder="Votre commentaire" aria-label="Votre commentaire"></textarea>
                        <button class="btn-secondary" @onclick="SubmitReview" disabled="@(ReviewRating < 1)">Publier mon avis</button>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(ReviewMessage))
                {
                    <div class="alert-error" role="alert">@ReviewMessage</div>
                }

                @if (Reviews.TotalReviews == 0)
                {
                    <p class="reviews-empty">Aucun avis pour le moment. Soyez le premier à partager votre retour.</p>
                }

                @foreach (var review in VisibleReviews)
                {
                    <div class="review-item">
                        <strong>@review.UserName</strong>
                        <StarRating Rating="@review.Rating" />
                        <small>@review.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</small>
                        <p>@review.Comment</p>
                        @if (IsEnrolled && !IsPreview)
                        {
                            @if (ReportingReviewId == review.Id)
                            {
                                <div class="review-report-form">
                                    <textarea @bind="ReportReason" rows="2" placeholder="Pourquoi signalez-vous cet avis ?" aria-label="Motif du signalement"></textarea>
                                    <button class="btn-secondary btn-small" @onclick="ReportReview">Envoyer le signalement</button>
                                    <button class="btn-secondary btn-small" @onclick="CancelReport">Annuler</button>
                                </div>
                            }
                            else
                            {
                                <button class="btn-secondary btn-small" @onclick="() => StartReport(review.Id)">Signaler</button>
                            }
                        }
                    </div>
                }

                @* Les avis etaient tous rendus d'un bloc, sans limite. *@
                @if (Reviews.Reviews.Count > VisibleReviewCount)
                {
                    <button class="btn-secondary" @onclick="ShowMoreReviews">
                        Voir plus d'avis (@(Reviews.Reviews.Count - VisibleReviewCount) restants)
                    </button>
                }
            </div>
        }
    </div>
}
else if (IsLoading)
{
    <LoadingState Message="Chargement du cours..." />
}
else
{
    <div class="course-detail-container">
        <AlertMessage Message="Ce cours est introuvable ou n'est plus disponible." />
        <button class="btn-primary" @onclick='() => Nav.NavigateTo("/explore")'>Retour au catalogue</button>
    </div>
}
@code {
    [Parameter] public Guid CourseId { get; set; }
    private CourseDto? Course;
    private bool IsLoading = true;
    private bool IsEnrolled = false;
    private bool IsPreview => Nav.ToAbsoluteUri(Nav.Uri).Query
        .Contains("preview=true", StringComparison.OrdinalIgnoreCase);
    private string EnrolledPlan = "";
    private string SelectedPlan = "";
    private bool ShowPayment = false;
    private bool IsProcessing = false;
    private string PaymentError = "";
    private string CardName = "";
    private string CardNumber = "";
    private string CardExpiry = "";
    private string CardCvv = "";
    private ReviewSummary? Reviews;
    private int ReviewRating;
    private string ReviewComment = string.Empty;
    private string ReviewMessage = string.Empty;
    private Guid? ReportingReviewId;
    private string ReportReason = string.Empty;

    private const int ReviewPageSize = 5;
    private int VisibleReviewCount = ReviewPageSize;

    private IEnumerable<ReviewDto> VisibleReviews =>
        (Reviews?.Reviews ?? new List<ReviewDto>()).Take(VisibleReviewCount);

    private void ShowMoreReviews() => VisibleReviewCount += ReviewPageSize;

    /// <summary>
    /// Le contenu des modules n'est ouvrable que par un inscrit ou en previsualisation
    /// instructeur. Le programme reste visible dans les deux cas, seul l'acces differe.
    /// </summary>
    private bool CanOpenModules => IsEnrolled || IsPreview;

    private static string FormatDuration(int minutes)
    {
        if (minutes <= 0)
            return "Durée à préciser";
        if (minutes < 60)
            return $"{minutes} min";

        var hours = minutes / 60;
        var rest = minutes % 60;
        return rest == 0 ? $"{hours} h" : $"{hours} h {rest:00}";
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var httpClient = HttpClientFactory.CreateClient("EduPlatformAPI");
            Course = await httpClient.GetFromJsonAsync<CourseDto>($"api/Courses/{CourseId}");
            Reviews = await httpClient.GetFromJsonAsync<ReviewSummary>($"api/reviews/course/{CourseId}");

            if (AuthState.IsAuthenticated)
            {
                httpClient.DefaultRequestHeaders.Authorization =
                    new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", AuthState.Token);
                IsEnrolled = await httpClient.GetFromJsonAsync<bool>(
                    $"api/Courses/{CourseId}/enrollment-status");
            }
        }
        catch { Course = null; }
        finally { IsLoading = false; }
    }

    private async Task SubmitReview()
    {
        if (ReviewRating is < 1 or > 5)
            return;

        var client = HttpClientFactory.CreateAuthorizedClient(AuthState);
        var response = await client.PostAsJsonAsync(
            $"api/reviews/course/{CourseId}", new { rating = ReviewRating, comment = ReviewComment });
        if (response.IsSuccessStatusCode)
        {
            Reviews = await client.GetFromJsonAsync<ReviewSummary>($"api/reviews/course/{CourseId}");
            ReviewComment = string.Empty;
        }
    }

    private void StartReport(Guid reviewId)
    {
        ReportingReviewId = reviewId;
        ReportReason = string.Empty;
        ReviewMessage = string.Empty;
    }

    private void CancelReport()
    {
        ReportingReviewId = null;
        ReportReason = string.Empty;
    }

    private async Task ReportReview()
    {
        if (ReportingReviewId is null || string.IsNullOrWhiteSpace(ReportReason))
        {
            ReviewMessage = "Le motif du signalement est obligatoire.";
            return;
        }

        var client = HttpClientFactory.CreateAuthorizedClient(AuthState);
        var response = await client.PostAsJsonAsync(
            $"api/reviews/{ReportingReviewId}/report", new { reason = ReportReason });
        if (response.IsSuccessStatusCode)
        {
            ReviewMessage = "Merci, votre signalement a été transmis aux administrateurs.";
            CancelReport();
        }
        else
        {
            var body = await response.Content.ReadFromJsonAsync<Dictionary<string, string>>();
            ReviewMessage = body?.GetValueOrDefault("message") ?? "Le signalement n'a pas pu être envoyé.";
        }
    }

    private void SelectPlan(string plan) => SelectedPlan = plan;
    private void GoBack() => ShowPayment = false;

    private void ProceedToPayment()
    {
        if (!AuthState.IsAuthenticated)
        {
            Nav.NavigateTo("/login");
            return;
        }
        ShowPayment = true;
    }

    private decimal GetPlanPrice()
    {
        if (Course == null) return 0;
        return SelectedPlan switch
        {
            "Free" => 0,
            "Standard" => Course.Price,
            "Premium" => Course.Price * 1.5m,
            _ => 0
        };
    }

    private async Task ProcessPayment()
    {
        if (!AuthState.IsAuthenticated)
        {
            Nav.NavigateTo("/login");
            return;
        }

        if (SelectedPlan != "Free" && (string.IsNullOrWhiteSpace(CardNumber) || CardNumber.Replace(" ", "").Length < 16))
        {
            PaymentError = "Veuillez entrer un numéro de carte valide.";
            return;
        }

        IsProcessing = true;
        PaymentError = "";

        try
        {
            var httpClient = HttpClientFactory.CreateClient("EduPlatformAPI");
            httpClient.DefaultRequestHeaders.Authorization =
                new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", AuthState.Token);

            var response = await httpClient.PostAsJsonAsync("api/progress/enroll", new
            {
                courseId = CourseId,
                sessionId = AuthState.SessionId,
                plan = SelectedPlan,
                amountPaid = GetPlanPrice()
            });

            if (response.IsSuccessStatusCode)
            {
                IsEnrolled = true;
                EnrolledPlan = SelectedPlan;
                ShowPayment = false;
            }
            else
            {
                var body = await response.Content.ReadFromJsonAsync<Dictionary<string, string>>();
                PaymentError = body?.GetValueOrDefault("message") ?? "Erreur lors du paiement.";
            }
        }
        catch
        {
            PaymentError = "Erreur de connexion. Réessayez.";
        }
        finally
        {
            IsProcessing = false;
        }
    }

    private void GoToTest() => Nav.NavigateTo($"/courses/{CourseId}/test");
    private void GoToLearning() => Nav.NavigateTo($"/courses/{CourseId}/learn");
    private void GoToCertificate() => Nav.NavigateTo($"/courses/{CourseId}/certificate");

    private class CourseDto
    {
        public Guid Id { get; set; }
        public string Title { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
        public string Category { get; set; } = string.Empty;
        public string Level { get; set; } = string.Empty;
        public int DurationMinutes { get; set; }
        public decimal Price { get; set; }
        public string ThumbnailUrl { get; set; } = string.Empty;
        public List<ModuleDto> Modules { get; set; } = new();
    }

    private class ModuleDto
    {
        public Guid Id { get; set; }
        public string Title { get; set; } = string.Empty;
        public int DurationMinutes { get; set; }
        public int Order { get; set; }
    }

    private class ReviewSummary
    {
        public double AverageRating { get; set; }
        public int TotalReviews { get; set; }
        public List<ReviewDto> Reviews { get; set; } = new();
    }

    private class ReviewDto
    {
        public Guid Id { get; set; }
        public int Rating { get; set; }
        public string Comment { get; set; } = string.Empty;
        public string UserName { get; set; } = string.Empty;
        public DateTime CreatedAt { get; set; }
    }
}
