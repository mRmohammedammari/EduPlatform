@page "/admin"
@rendermode InteractiveServer
@implements IDisposable
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager Nav
@inject EduPlatform.Web.Services.AuthStateService AuthState
@inject IJSRuntime JS

<PageTitle>Tableau de bord administrateur - EduPlatform</PageTitle>

@if (!IsAdmin)
{
    <div class="profile-container">
        <div class="alert-error">Cette page est réservée aux administrateurs.</div>
        <button class="btn-primary" @onclick="GoToHome">Retour à l'accueil</button>
    </div>
}
else
{
    <div class="page-header">
        <h1>Tableau de bord administrateur</h1>
        <p>Vue globale de l'activité de la plateforme.</p>
    </div>

    @if (IsLoading)
    {
        <p>Chargement...</p>
    }
    else if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <AlertMessage Message="@ErrorMessage" />
    }
    else if (Overview != null)
    {
        <div class="stats-grid">
            <div class="stat-card"><span class="stat-value">@Overview.Users</span><span class="stat-label">Utilisateurs</span></div>
            <div class="stat-card"><span class="stat-value">@Overview.ActiverUsers</span><span class="stat-label">Comptes actifs</span></div>
            <div class="stat-card"><span class="stat-value">@Overview.SuspendedUsers</span><span class="stat-label">Comptes suspendus</span></div>
            <div class="stat-card"><span class="stat-value">@Overview.Students</span><span class="stat-label">Étudiants</span></div>
            <div class="stat-card"><span class="stat-value">@Overview.Instructors</span><span class="stat-label">Enseignants</span></div>
            <div class="stat-card"><span class="stat-value">@Overview.Courses</span><span class="stat-label">Cours</span></div>
            <div class="stat-card"><span class="stat-value">@Overview.PublishedCourses</span><span class="stat-label">Cours publiés</span></div>
            <div class="stat-card"><span class="stat-value">@Overview.PendingCourses</span><span class="stat-label">En attente de validation</span></div>
            <div class="stat-card"><span class="stat-value">@Overview.Modules</span><span class="stat-label">Modules</span></div>
            <div class="stat-card"><span class="stat-value">@Overview.Enrollments</span><span class="stat-label">Inscriptions</span></div>
            <div class="stat-card"><span class="stat-value">@Overview.RecentEnrollments</span><span class="stat-label">Inscriptions récentes</span></div>
            <div class="stat-card"><span class="stat-value">@Overview.Questions</span><span class="stat-label">Questions</span></div>
        </div>

        @if (Overview.PendingCourses > 0 || Overview.SuspendedUsers > 0)
        {
            <div class="admin-alerts">
                <h2>Alertes nécessitant une action</h2>
                @if (Overview.PendingCourses > 0)
                {
                    <button class="admin-alert" @onclick="GoToCourseApprovals">
                        <strong>@Overview.PendingCourses cours</strong>
                        <span>en attente de validation</span>
                    </button>
                }
                @if (Overview.SuspendedUsers > 0)
                {
                    <button class="admin-alert" @onclick="GoToUsers">
                        <strong>@Overview.SuspendedUsers compte(s)</strong>
                        <span>suspendu(s)  vérifier</span>
                    </button>
                }
            </div>
        }

        <button class="btn-primary" @onclick="GoToUsers">Gérer les utilisateurs</button>
        <button class="btn-primary" @onclick="GoToCourseApprovals">Cours à valider (@Overview.PendingCourses)</button>
        <button class="btn-secondary" @onclick="DownloadReport">Télécharger le rapport CSV</button>

        <div class="course-section admin-category-section">
            <h2>Catégories de cours</h2>
            @if (CategoriesLoading)
            {
                <LoadingState Message="Chargement des catégories..." />
            }
            else
            {
                <div class="admin-category-form">
                    <input @bind="NewCategoryName" placeholder="Nouvelle catégorie" />
                    <button class="btn-secondary" @onclick="CreateCategory">Ajouter</button>
                </div>
                <div class="admin-category-list">
                    @foreach (var category in Categories)
                    {
                        <div class="admin-category-row">
                            <span>@category.Name</span>
                            <button class="btn-small @(category.IsActiver ? "btn-secondary" : "btn-primary")"
                                    @onclick="() => ToggleCategory(category)">
                                @(category.IsActiver ? "Désactiver" : "Activerr")
                            </button>
                        </div>
                    }
                </div>
            }
        </div>
    }
}

@code {
    private bool IsLoading = true;
    private string ErrorMessage = string.Empty;
    private OverviewDto? Overview;
    private bool DataLoaded;
    private bool CategoriesLoading = true;
    private string NewCategoryName = string.Empty;
    private List<CategoryDto> Categories = new();
    private bool IsAdmin => AuthState.IsAuthenticated && AuthState.Role == "Admin";

    protected override void OnInitialized()
    {
        AuthState.OnChange += OnAuthStateChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await AuthState.InitializeAsync();
            await EvaluateAuthStateAsync();
        }
    }

    private async void OnAuthStateChanged()
    {
        await InvokeAsync(async () =>
        {
            await EvaluateAuthStateAsync();
            StateHasChanged();
        });
    }

    private async Task EvaluateAuthStateAsync()
    {
        if (!IsAdmin)
        {
            IsLoading = false;
            return;
        }
        if (DataLoaded)
            return;
        DataLoaded = true;

        try
        {
            var client = HttpClientFactory.CreateClient("EduPlatformAPI");
            client.DefaultRequestHeaders.Authorization =
                new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", AuthState.Token);
            Overview = await client.GetFromJsonAsync<OverviewDto>("api/admin/overview");
            Categories = await client.GetFromJsonAsync<List<CategoryDto>>("api/admin/categories") ?? new();
        }
        catch
        {
            ErrorMessage = "Impossible de charger les statistiques.";
        }
        finally
        {
            IsLoading = false;
            CategoriesLoading = false;
        }
    }

    private async Task CreateCategory()
    {
        if (string.IsNullOrWhiteSpace(NewCategoryName))
            return;

        var response = await CreateAuthorizedClient().PostAsJsonAsync(
            "api/admin/categories", new { name = NewCategoryName });
        if (response.IsSuccessStatusCode)
        {
            var category = await response.Content.ReadFromJsonAsync<CategoryDto>();
            if (category is not null)
                Categories.Add(category);
            NewCategoryName = string.Empty;
        }
    }

    private async Task ToggleCategory(CategoryDto category)
    {
        var response = await CreateAuthorizedClient().PutAsync(
            $"api/admin/categories/{category.Id}/toggle", null);
        if (response.IsSuccessStatusCode)
            category.IsActiver = !category.IsActiver;
    }

    public void Dispose()
    {
        AuthState.OnChange -= OnAuthStateChanged;
    }

    private void GoToHome() => Nav.NavigateTo("/");
    private void GoToUsers() => Nav.NavigateTo("/admin/users");
    private void GoToCourseApprovals() => Nav.NavigateTo("/admin/courses");

    private async Task DownloadReport()
    {
        var response = await CreateAuthorizedClient().GetAsync("api/admin/reports/courses.csv");
        if (!response.IsSuccessStatusCode)
            return;

        var content = await response.Content.ReadAsByteArrayAsync();
        await JS.InvokeVoidAsync("eduPlatformSession.download", "eduplatform-courses.csv", content);
    }

    private HttpClient CreateAuthorizedClient() => HttpClientFactory.CreateAuthorizedClient(AuthState);

    private sealed class OverviewDto
    {
        public int Users { get; set; }
        public int ActiverUsers { get; set; }
        public int SuspendedUsers { get; set; }
        public int Students { get; set; }
        public int Instructors { get; set; }
        public int Courses { get; set; }
        public int PublishedCourses { get; set; }
        public int PendingCourses { get; set; }
        public int Modules { get; set; }
        public int Enrollments { get; set; }
        public int RecentEnrollments { get; set; }
        public int Questions { get; set; }
    }

    private sealed class CategoryDto
    {
        public Guid Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public bool IsActiver { get; set; }
    }
}
