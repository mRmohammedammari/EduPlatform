@page "/courses"
@page "/explore"
@rendermode InteractiveServer
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager Nav

@using Microsoft.AspNetCore.Components

<PageTitle>Explorer les cours - EduPlatform</PageTitle>

<div class="explore-page">
    <section class="explore-hero">
        <div class="explore-copy">
            <span class="eyebrow dark">EXPLORER EDUPLATFORM</span>
            <h1>Un nouveau sujet à portée de clic.</h1>
            <p>Parcourez les formations publiées, filtrez par niveau et trouvez le prochain cours qui vous fera progresser.</p>
        </div>

        <div class="explore-metrics">
            <div class="mini-stat">
                <strong>@FormatStat(Stats?.PublishedCourses)</strong>
                <span>formations</span>
            </div>
            <div class="mini-stat">
                <strong>@FormatStat(Stats?.Categories)</strong>
                <span>catégories</span>
            </div>
            <button class="market-button explore-recommendations" @onclick='() => Nav.NavigateTo("/recommendations")'>Mes recommandations</button>
        </div>
    </section>

    <div class="explore-toolbar">
        <strong>@MatchCount cours disponibles</strong>

        <div class="filters">
            @* L'ordre des <select> est contractuel : les tests E2E ciblent categorie puis niveau. *@
            <select class="explore-select" aria-label="Filtrer par catégorie"
                    @bind="SelectedCategory" @bind:after="ApplyFilters">
                <option value="">Toutes les catégories</option>
                @foreach (var category in AvailableCategories)
                {
                    <option value="@category">@category</option>
                }
            </select>

            <select class="explore-select" aria-label="Filtrer par niveau"
                    @bind="SelectedLevel" @bind:after="ApplyFilters">
                <option value="">Tous les niveaux</option>
                <option value="Debutant">Débutant</option>
                <option value="Intermediaire">Intermédiaire</option>
                <option value="Avance">Avancé</option>
            </select>

            <select class="explore-select" aria-label="Trier les résultats"
                    @bind="SelectedSort" @bind:after="ApplyFilters">
                <option value="recent">Les plus récents</option>
                <option value="rating">Les mieux notés</option>
                <option value="popular">Les plus suivis</option>
                <option value="title">Titre (A-Z)</option>
                <option value="duration-asc">Durée croissante</option>
                <option value="duration-desc">Durée décroissante</option>
            </select>

            <SearchBar Value="@SearchTerm"
                       Submitted="ApplySearch"
                       Placeholder="Rechercher dans le catalogue"
                       AriaLabel="Rechercher dans le catalogue"
                       CssClass="explore-search" />
        </div>
    </div>

    @if (ActiveFilters.Any())
    {
        <div class="explore-active-filters">
            <span>Filtres actifs :</span>
            @foreach (var filter in ActiveFilters)
            {
                <button type="button" class="filter-chip" @onclick="() => ClearFilter(filter.Key)">
                    @filter.Value <span aria-hidden="true">&times;</span>
                    <span class="visually-hidden">Retirer ce filtre</span>
                </button>
            }
            <button type="button" class="filter-chip-reset" @onclick="ClearAllFilters">Tout effacer</button>
        </div>
    }

    @if (IsLoading)
    {
        <div class="CourseList-grid" aria-busy="true" aria-live="polite">
            @* Squelettes plutot qu'un simple texte : la grille ne saute pas au chargement. *@
            @for (var index = 0; index < 6; index++)
            {
                <div class="course-card-skeleton">
                    <div class="skeleton-cover"></div>
                    <div class="skeleton-line skeleton-line-short"></div>
                    <div class="skeleton-line"></div>
                    <div class="skeleton-line"></div>
                </div>
            }
        </div>
    }
    else if (LoadFailed)
    {
        <AlertMessage Message="Impossible de charger le catalogue. Vérifiez votre connexion puis réessayez." />
        <button class="btn-primary" @onclick="LoadCourseList">Réessayer</button>
    }
    else if (PagedCourses.Any())
    {
        <div class="CourseList-grid">
            @foreach (var course in PagedCourses)
            {
                <CourseCard CourseId="@course.Id"
                            Title="@course.Title"
                            Description="@course.Description"
                            Category="@course.Category"
                            Level="@course.Level"
                            DurationMinutes="@course.DurationMinutes"
                            ThumbnailUrl="@course.ThumbnailUrl"
                            AverageRating="@course.AverageRating"
                            ReviewCount="@course.ReviewCount"
                            ModuleCount="@course.ModuleCount"
                            EnrollmentCount="@course.EnrollmentCount"
                            OnSelected="GoToCourse" />
            }
        </div>

        <Pagination CurrentPage="@CurrentPage"
                    TotalItems="@MatchCount"
                    PageSize="@PageSize"
                    PageChanged="GoToPage" />
    }
    else
    {
        <div class="explore-empty">
            <p>Aucun cours ne correspond à votre recherche.</p>
            @if (ActiveFilters.Any())
            {
                <button class="btn-secondary" @onclick="ClearAllFilters">Effacer les filtres</button>
            }
        </div>
    }
</div>

@code {
    private const int PageSize = 12;

    private List<CourseDto> PagedCourses = new();
    private int MatchCount;
    private CourseStatsDto? Stats;
    private bool IsLoading = true;
    private bool LoadFailed;
    private bool HasLoaded;
    private List<string> AvailableCategories = new();

    // Tout l'etat de navigation vit dans l'URL : une recherche filtree est partageable,
    // et le retour arriere du navigateur restitue la selection precedente.
    [SupplyParameterFromQuery(Name = "search")]
    public string? SearchTermQuery { get; set; }

    [SupplyParameterFromQuery(Name = "category")]
    public string? CategoryQuery { get; set; }

    [SupplyParameterFromQuery(Name = "level")]
    public string? LevelQuery { get; set; }

    [SupplyParameterFromQuery(Name = "sort")]
    public string? SortQuery { get; set; }

    [SupplyParameterFromQuery(Name = "page")]
    public int? PageQuery { get; set; }

    private string SearchTerm = string.Empty;
    private string SelectedCategory = string.Empty;
    private string SelectedLevel = string.Empty;
    private string SelectedSort = "recent";
    private int CurrentPage = 1;

    private string? LoadedCategory;
    private string? LoadedLevel;
    private string? LoadedSearch;
    private string? LoadedSort;
    private int? LoadedPage;

    private Dictionary<string, string> ActiveFilters
    {
        get
        {
            var filters = new Dictionary<string, string>();
            if (!string.IsNullOrWhiteSpace(SearchTerm))
                filters["search"] = $"« {SearchTerm} »";
            if (!string.IsNullOrWhiteSpace(SelectedCategory))
                filters["category"] = SelectedCategory;
            if (!string.IsNullOrWhiteSpace(SelectedLevel))
                filters["level"] = LevelLabel(SelectedLevel);
            return filters;
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        SearchTerm = SearchTermQuery ?? string.Empty;
        SelectedCategory = CategoryQuery ?? string.Empty;
        SelectedLevel = LevelQuery ?? string.Empty;
        SelectedSort = string.IsNullOrWhiteSpace(SortQuery) ? "recent" : SortQuery;
        CurrentPage = Math.Max(1, PageQuery ?? 1);

        if (!HasLoaded
            || LoadedCategory != SelectedCategory
            || LoadedLevel != SelectedLevel
            || LoadedSearch != SearchTerm
            || LoadedSort != SelectedSort
            || LoadedPage != CurrentPage)
        {
            await LoadCourseList();
        }

        if (Stats is null)
            await LoadStats();
    }

    private async Task LoadStats()
    {
        try
        {
            var httpClient = HttpClientFactory.CreateClient("EduPlatformAPI");
            Stats = await httpClient.GetFromJsonAsync<CourseStatsDto>("api/courses/stats");
        }
        catch (Exception)
        {
            Stats = null;
        }
    }

    private static string FormatStat(int? value) => value is null ? "—" : value.Value.ToString();

    private async Task LoadCourseList()
    {
        IsLoading = true;
        LoadFailed = false;
        try
        {
            var httpClient = HttpClientFactory.CreateClient("EduPlatformAPI");
            var url = "api/courses/paged"
                + $"?category={Uri.EscapeDataString(SelectedCategory)}"
                + $"&level={Uri.EscapeDataString(SelectedLevel)}"
                + $"&search={Uri.EscapeDataString(SearchTerm)}"
                + $"&sort={Uri.EscapeDataString(SelectedSort)}"
                + $"&page={CurrentPage}"
                + $"&pageSize={PageSize}";

            var response = await httpClient.GetFromJsonAsync<PagedCourseResultDto>(url);
            PagedCourses = response?.Items ?? new List<CourseDto>();
            MatchCount = response?.TotalItems ?? 0;
            LoadedCategory = SelectedCategory;
            LoadedLevel = SelectedLevel;
            LoadedSearch = SearchTerm;
            LoadedSort = SelectedSort;
            LoadedPage = CurrentPage;
            HasLoaded = true;

            if (string.IsNullOrWhiteSpace(SelectedCategory) && string.IsNullOrWhiteSpace(SelectedLevel))
                await LoadCategories();
        }
        catch (Exception)
        {
            // Distingue l'echec d'appel d'un catalogue reellement vide : afficher
            // « aucun cours disponible » sur une erreur reseau etait trompeur.
            PagedCourses = new List<CourseDto>();
            MatchCount = 0;
            LoadFailed = true;
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task LoadCategories()
    {
        try
        {
            var httpClient = HttpClientFactory.CreateClient("EduPlatformAPI");
            var categories = await httpClient
                .GetFromJsonAsync<List<CategoryDto>>("api/courses/categories");
            AvailableCategories = (categories ?? new List<CategoryDto>())
                .Select(category => category.Name)
                .ToList();
        }
        catch (Exception)
        {
            // Repli sur les categories presentes dans la page courante.
            AvailableCategories = PagedCourses
                .Select(course => course.Category)
                .Where(category => !string.IsNullOrWhiteSpace(category))
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .OrderBy(category => category)
                .ToList();
        }
    }

    private void ApplyFilters() => Navigate(page: 1);

    private void ApplySearch(string term)
    {
        SearchTerm = term;
        Navigate(page: 1);
    }

    private void GoToPage(int page) => Navigate(page);

    private void ClearFilter(string key)
    {
        switch (key)
        {
            case "search": SearchTerm = string.Empty; break;
            case "category": SelectedCategory = string.Empty; break;
            case "level": SelectedLevel = string.Empty; break;
        }
        Navigate(page: 1);
    }

    private void ClearAllFilters()
    {
        SearchTerm = string.Empty;
        SelectedCategory = string.Empty;
        SelectedLevel = string.Empty;
        SelectedSort = "recent";
        Navigate(page: 1);
    }

    private void Navigate(int page)
    {
        var parameters = new List<string>();
        if (!string.IsNullOrWhiteSpace(SearchTerm))
            parameters.Add($"search={Uri.EscapeDataString(SearchTerm)}");
        if (!string.IsNullOrWhiteSpace(SelectedCategory))
            parameters.Add($"category={Uri.EscapeDataString(SelectedCategory)}");
        if (!string.IsNullOrWhiteSpace(SelectedLevel))
            parameters.Add($"level={Uri.EscapeDataString(SelectedLevel)}");
        if (SelectedSort != "recent")
            parameters.Add($"sort={Uri.EscapeDataString(SelectedSort)}");
        if (page > 1)
            parameters.Add($"page={page}");

        var query = parameters.Count == 0 ? string.Empty : "?" + string.Join("&", parameters);
        Nav.NavigateTo($"/explore{query}");
    }

    private static string LevelLabel(string level) => level switch
    {
        "Debutant" => "Débutant",
        "Intermediaire" => "Intermédiaire",
        "Avance" => "Avancé",
        _ => level
    };

    private void GoToCourse(Guid id) => Nav.NavigateTo($"/courses/{id}");

    private sealed class CourseDto
    {
        public Guid Id { get; set; }
        public string Title { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
        public string Category { get; set; } = string.Empty;
        public string Level { get; set; } = string.Empty;
        public int DurationMinutes { get; set; }
        public string ThumbnailUrl { get; set; } = string.Empty;
        public DateTime CreatedAt { get; set; }
        public int ModuleCount { get; set; }
        public int EnrollmentCount { get; set; }
        public double AverageRating { get; set; }
        public int ReviewCount { get; set; }
    }

    private sealed class CategoryDto
    {
        public string Name { get; set; } = string.Empty;
        public int CourseCount { get; set; }
        public string ThumbnailUrl { get; set; } = string.Empty;
    }

    private sealed class PagedCourseResultDto
    {
        public List<CourseDto> Items { get; set; } = new();
        public int TotalItems { get; set; }
        public int Page { get; set; }
        public int PageSize { get; set; }
        public int TotalPages { get; set; }
    }

    private sealed class CourseStatsDto
    {
        public int PublishedCourses { get; set; }
        public int Categories { get; set; }
        public int Modules { get; set; }
        public int ActiveLearners { get; set; }
    }
}
