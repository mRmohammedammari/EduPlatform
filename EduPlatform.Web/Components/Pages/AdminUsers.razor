@page "/admin/users"
@rendermode InteractiveServer
@implements IDisposable
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager Nav
@inject EduPlatform.Web.Services.AuthStateService AuthState

@if (!IsAdmin)
{
    <div class="profile-container">
        <div class="alert-error">Cette page est réservée aux administrateurs.</div>
        <button class="btn-primary" @onclick="GoToHome">Retour à l'accueil</button>
    </div>
}
else
{
    <div class="page-header">
        <h1>Gestion des utilisateurs</h1>
        <p>Attribuez les rôles nécessaires aux membres de la plateforme.</p>
    </div>

    @if (IsLoading)
    {
        <p>Chargement...</p>
    }
    else if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <div class="alert-error">@ErrorMessage</div>
    }
    else
    {
        <div class="admin-users-filters">
            <input type="text" class="admin-users-search" placeholder="Rechercher par nom ou email..." @bind="SearchTerm" @bind:event="oninput" @bind:after="ResetPage" />
            <select @bind="RoleFilter" @bind:after="ResetPage">
                <option value="">Tous les rôles</option>
                <option value="Student">Étudiants</option>
                <option value="Instructor">Enseignants</option>
                <option value="Admin">Gestionnaires</option>
            </select>
            <span class="admin-users-count">@FilteredUsers.Count() utilisateur(s)</span>
        </div>

        <div class="course-section">
            @foreach (var user in PagedUsers)
            {
                <div class="activity-row">
                    <div>
                        <strong>@user.FirstName @user.LastName</strong>
                        <p>@user.Email</p>
                        @if (user.IsSuspended)
                        {
                            <span class="badge-status rejected">Suspendu</span>
                        }
                    </div>
                    <div class="activity-meta">
                        <select value="@user.Role" @onchange="eventArgs => UpdateRole(user.Id, eventArgs.Value?.ToString())">
                            <option value="Student">Étudiant</option>
                            <option value="Instructor">Enseignant</option>
                            <option value="Admin">Gestionnaire</option>
                        </select>
                        <small>@user.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</small>
                        @if (user.IsSuspended)
                        {
                            <button class="btn-secondary btn-small" @onclick="() => RequestSuspensionChange(user, false)">Réactiver</button>
                        }
                        else
                        {
                            <button class="btn-secondary btn-small" @onclick="() => RequestSuspensionChange(user, true)">Suspendre</button>
                        }
                    </div>
                </div>
            }
        </div>
            <Pagination CurrentPage="@CurrentPage"
                    TotalItems="@FilteredUsersList.Count"
                    PageSize="@PageSize"
                    PageChanged="ChangePage" />
    }
}

<Modal IsOpen="@IsSuspensionModalOpen"
       Title="@(PendingSuspension ? "Suspendre l'utilisateur" : "R�activer l'utilisateur")"
       ConfirmText="@(PendingSuspension ? "Suspendre" : "R�activer")"
       IsBusy="@IsSuspensionInProgress"
       OnClose="CloseSuspensionModal"
       OnConfirm="ConfirmSuspensionChange">
    @if (PendingUser is not null)
    {
        <p>Confirmer l'op�ration pour <strong>@PendingUser.FirstName @PendingUser.LastName</strong> (@PendingUser.Email) ?</p>
    }
</Modal>

<Toast Message="@ToastMessage"
    Tone="@ToastTone"
    IsVisible="@IsToastVisible"
    OnDismiss="DismissToast" />

@code {
    private bool IsLoading = true;
    private string ErrorMessage = string.Empty;
    private List<UserDto> Users = new();
    private bool DataLoaded;
    private string SearchTerm = string.Empty;
    private string RoleFilter = string.Empty;
    private bool IsAdmin => AuthState.IsAuthenticated && AuthState.Role == "Admin";
    private UserDto? PendingUser;
    private bool PendingSuspension;
    private bool IsSuspensionModalOpen;
    private bool IsSuspensionInProgress;
    private string ToastMessage = string.Empty;
    private Toast.ToastTone ToastTone = Toast.ToastTone.Success;
    private bool IsToastVisible;
    private const int PageSize = 10;
    private int CurrentPage = 1;

    private IEnumerable<UserDto> FilteredUsers => Users.Where(u =>
        (string.IsNullOrWhiteSpace(RoleFilter) || u.Role == RoleFilter) &&
        (string.IsNullOrWhiteSpace(SearchTerm) ||
            $"{u.FirstName} {u.LastName}".Contains(SearchTerm, StringComparison.OrdinalIgnoreCase) ||
            u.Email.Contains(SearchTerm, StringComparison.OrdinalIgnoreCase)));

    private List<UserDto> FilteredUsersList => FilteredUsers.ToList();

    private IEnumerable<UserDto> PagedUsers => FilteredUsersList
        .Skip((Math.Max(1, CurrentPage) - 1) * PageSize)
        .Take(PageSize);

    protected override void OnInitialized()
    {
        AuthState.OnChange += OnAuthStateChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await AuthState.InitializeAsync();
            await EvaluateAuthStateAsync();
        }
    }

    private async void OnAuthStateChanged()
    {
        await InvokeAsync(async () =>
        {
            await EvaluateAuthStateAsync();
            StateHasChanged();
        });
    }

    private async Task EvaluateAuthStateAsync()
    {
        if (!IsAdmin)
        {
            IsLoading = false;
            return;
        }
        if (DataLoaded)
            return;
        DataLoaded = true;

        try
        {
            Users = await CreateAuthorizedClient().GetFromJsonAsync<List<UserDto>>(
                "api/admin/users") ?? new();
        }
        catch
        {
            ErrorMessage = "Impossible de charger les utilisateurs.";
        }
        finally
        {
            IsLoading = false;
        }
    }

    public void Dispose()
    {
        AuthState.OnChange -= OnAuthStateChanged;
    }

    private async Task UpdateRole(Guid userId, string? role)
    {
        if (string.IsNullOrWhiteSpace(role))
            return;

        try
        {
            var response = await CreateAuthorizedClient().PutAsJsonAsync(
                $"api/admin/users/{userId}/role", new { role });
            if (!response.IsSuccessStatusCode)
                ShowToast("La modification du rôle a échouée.", Toast.ToastTone.Error);
            else
                ShowToast("Rôle mis à jour.");
        }
        catch
        {
            ShowToast("Erreur de connexion.", Toast.ToastTone.Error);
        }
    }

    private HttpClient CreateAuthorizedClient() => HttpClientFactory.CreateAuthorizedClient(AuthState);

    private void GoToHome() => Nav.NavigateTo("/");

    private void RequestSuspensionChange(UserDto user, bool suspend)
    {
        PendingUser = user;
        PendingSuspension = suspend;
        IsSuspensionModalOpen = true;
    }

    private void CloseSuspensionModal()
    {
        if (!IsSuspensionInProgress)
        {
            IsSuspensionModalOpen = false;
            PendingUser = null;
        }
    }

    private async Task ConfirmSuspensionChange()
    {
        if (PendingUser is null)
            return;

        IsSuspensionInProgress = true;
        await ToggleSuspension(PendingUser, PendingSuspension);
        IsSuspensionInProgress = false;
        if (string.IsNullOrWhiteSpace(ErrorMessage))
            CloseSuspensionModal();
    }

    private async Task ToggleSuspension(UserDto user, bool suspend)
    {
        try
        {
            var action = suspend ? "suspend" : "reactivate";
            var response = await CreateAuthorizedClient().PutAsync(
                $"api/admin/users/{user.Id}/{action}", null);
            if (response.IsSuccessStatusCode)
            {
                user.IsSuspended = suspend;
                ShowToast(suspend ? "Utilisateur suspendu." : "Utilisateur réactivé.");
            }
            else
            {
                ShowToast("L'opération a échoué.", Toast.ToastTone.Error);
            }
        }
        catch
        {
            ShowToast("Erreur de connexion.", Toast.ToastTone.Error);
        }
    }

    private void ShowToast(string message, Toast.ToastTone tone = Toast.ToastTone.Success)
    {
        ToastMessage = message;
        ToastTone = tone;
        IsToastVisible = true;
    }

    private void DismissToast()
    {
        IsToastVisible = false;
        ToastMessage = string.Empty;
    }

    private Task ChangePage(int page)
    {
        CurrentPage = page;
        return Task.CompletedTask;
    }

    private void ResetPage()
    {
        CurrentPage = 1;
    }

    private sealed class UserDto
    {
        public Guid Id { get; set; }
        public string Email { get; set; } = string.Empty;
        public string FirstName { get; set; } = string.Empty;
        public string LastName { get; set; } = string.Empty;
        public string Role { get; set; } = string.Empty;
        public DateTime CreatedAt { get; set; }
        public bool IsSuspended { get; set; }
    }
}
