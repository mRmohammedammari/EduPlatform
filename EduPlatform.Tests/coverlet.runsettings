<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <Format>cobertura,opencover</Format>
          <!-- Le code mesure est le code metier : API, Core, Data, BigData. -->
          <Include>[EduPlatform.API]*,[EduPlatform.Core]*,[EduPlatform.Data]*,[EduPlatform.BigData]*</Include>
          <!-- Exclusions : code genere, migrations EF et points d'entree sans logique. -->
          <Exclude>[*]*.Migrations.*,[*]Program,[*]*Dto,[EduPlatform.Tests]*</Exclude>
          <ExcludeByAttribute>Obsolete,GeneratedCodeAttribute,CompilerGeneratedAttribute,ExcludeFromCodeCoverageAttribute</ExcludeByAttribute>
          <SkipAutoProps>true</SkipAutoProps>
          <UseSourceLink>true</UseSourceLink>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
